{
  // Activa sugerencias inline de Copilot
  "github.copilot.inlineSuggest.enable": true,
  "editor.inlineSuggest.enabled": true,

  // Asegura que Copilot esté habilitado en todos los lenguajes
  "github.copilot.enable": {
    "*": true
  },

  // Elimina overrides conflictivos (no uses ElectronFetcher en remoto)
  "github.copilot.advanced.debug.useElectronFetcher": false,
  "github.copilot.advanced.debug.useNodeFetcher": true,
  "github.copilot.advanced.debug.useNodeFetchFetcher": false
}
