<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <ControllerSelector selected_controller="GeneralMPPI" default_controller="GeneralMPPI" topic_name="controller_selector"/>
        <PlannerSelector selected_planner="{selected_planner}" default_planner="GridBased" topic_name="planner_selector"/>
        
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="3" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}" />
            <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
          </RecoveryNode>
        </RateController>

        <ReactiveSequence name="MonitorAndFollowPath">
          <Inverter>
            <IsStuck/>
          </Inverter>
          <Sequence name="PathFollowingWithTruncation">
            <TruncatePath distance="1.0" input_path="{path}" output_path="{truncated_path}"/>
            <RecoveryNode number_of_retries="4" name="GeneralMPPI">
              <FollowPath path="{truncated_path}" controller_id="GeneralMPPI"/>
              <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
            </RecoveryNode>
          </Sequence>
        </ReactiveSequence>
      </PipelineSequence>

      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            <Wait wait_duration="1.0" name="WaitAfterClear"/>
          </Sequence>
          <Spin spin_dist="1.57" name="SpinRecovery"/>
          <Wait wait_duration="5.0" name="WaitRecovery"/>
          <BackUp backup_dist="0.15" backup_speed="0.05" name="BackUpRecovery"/>
          <Sequence name="RelocalizationRecovery">
            <ReinitializeGlobalLocalization name="ReinitLocalization"/>
            <Wait wait_duration="2.0" name="WaitAfterReinit"/>
          </Sequence>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>