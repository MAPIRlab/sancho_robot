<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <RetryUntilSuccessful num_attempts="-1">

      <Fallback name="LocalizationFallback">

        <!-- Exit condition -->
        <IsLocalized
          max_covariance="0.1"
          topic="/amcl_pose"/>

        <!-- Localization attempt -->
        <Sequence>

          <ReinitializeGlobalLocalization
            service_name="/reinitialize_global_localization"
            server_timeout="5000.0"/>

          <Spin spin_dist="3.14"/>

        </Sequence>

      </Fallback>

    </RetryUntilSuccessful>

  </BehaviorTree>
</root>
