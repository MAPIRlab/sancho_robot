SetFace_speaking [fillcolor=gray, fontcolor=black, fontsize=9, label=SetFace_speaking, shape=ellipse, style=filled];
Conversation -> SetFace_speaking;
RespondUser [fillcolor=gray, fontcolor=black, fontsize=9, label=RespondUser, shape=ellipse, style=filled];
Conversation -> RespondUser;
SetFace_idle [fillcolor=gray, fontcolor=black, fontsize=9, label=SetFace_idle, shape=ellipse, style=filled];
Conversation -> SetFace_idle;
ResetEngaged [fillcolor=gray, fontcolor=black, fontsize=9, label=ResetEngaged, shape=ellipse, style=filled];
HandleInteractionEnd -> ResetEngaged;
Idle [fillcolor=gray, fontcolor=black, fontsize=9, label=Idle, shape=ellipse, style=filled];
Priorities -> Idle;
}
