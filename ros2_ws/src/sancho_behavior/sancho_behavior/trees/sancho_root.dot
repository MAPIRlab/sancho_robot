digraph pastafarianism {
ordering=out;
graph [fontname="times-roman"];
node [fontname="times-roman"];
edge [fontname="times-roman"];
"Sancho Root" [fillcolor=gold, fontcolor=black, fontsize=9, label="Sancho Root\nSuccessOnAll", shape=parallelogram, style=filled];
Topics2BB [fillcolor=gold, fontcolor=black, fontsize=9, label="Topics2BB\nSuccessOnAll", shape=parallelogram, style=filled];
"Sancho Root" -> Topics2BB;
DoA2BB [fillcolor=gray, fontcolor=black, fontsize=9, label=DoA2BB, shape=ellipse, style=filled];
Topics2BB -> DoA2BB;
Hotword2BB [fillcolor=gray, fontcolor=black, fontsize=9, label=Hotword2BB, shape=ellipse, style=filled];
Topics2BB -> Hotword2BB;
OdomYaw2BB [fillcolor=gray, fontcolor=black, fontsize=9, label=OdomYaw2BB, shape=ellipse, style=filled];
Topics2BB -> OdomYaw2BB;
Speaker2BB [fillcolor=gray, fontcolor=black, fontsize=9, label=Speaker2BB, shape=ellipse, style=filled];
Topics2BB -> Speaker2BB;
Priorities [fillcolor=cyan, fontcolor=black, fontsize=9, label=Priorities, shape=octagon, style=filled];
"Sancho Root" -> Priorities;
ReactToSound [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ ReactToSound", shape=box, style=filled];
Priorities -> ReactToSound;
"Hotword?" [fillcolor=gray, fontcolor=black, fontsize=9, label="Hotword?", shape=ellipse, style=filled];
ReactToSound -> "Hotword?";
LockTarget [fillcolor=gray, fontcolor=black, fontsize=9, label=LockTarget, shape=ellipse, style=filled];
ReactToSound -> LockTarget;
DecideMovement [fillcolor=cyan, fontcolor=black, fontsize=9, label="Ⓜ DecideMovement", shape=octagon, style=filled];
ReactToSound -> DecideMovement;
TurnFar [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ TurnFar", shape=box, style=filled];
DecideMovement -> TurnFar;
"IsAngleFar?" [fillcolor=gray, fontcolor=black, fontsize=9, label="IsAngleFar?", shape=ellipse, style=filled];
TurnFar -> "IsAngleFar?";
TurnToSound [fillcolor=gray, fontcolor=black, fontsize=9, label=TurnToSound, shape=ellipse, style=filled];
TurnFar -> TurnToSound;
RotateHeadToSound [fillcolor=gray, fontcolor=black, fontsize=9, label=RotateHeadToSound, shape=ellipse, style=filled];
DecideMovement -> RotateHeadToSound;
StabilizeCamera [fillcolor=gray, fontcolor=black, fontsize=9, label=StabilizeCamera, shape=ellipse, style=filled];
ReactToSound -> StabilizeCamera;
IdentifyCentralTarget [fillcolor=gray, fontcolor=black, fontsize=9, label=IdentifyCentralTarget, shape=ellipse, style=filled];
ReactToSound -> IdentifyCentralTarget;
GreetUser [fillcolor=gray, fontcolor=black, fontsize=9, label=GreetUser, shape=ellipse, style=filled];
ReactToSound -> GreetUser;
SetEngaged [fillcolor=gray, fontcolor=black, fontsize=9, label=SetEngaged, shape=ellipse, style=filled];
ReactToSound -> SetEngaged;
Interaction [fillcolor=orange, fontcolor=black, fontsize=9, label=Interaction, shape=box, style=filled];
Priorities -> Interaction;
"IsEngaged?" [fillcolor=gray, fontcolor=black, fontsize=9, label="IsEngaged?", shape=ellipse, style=filled];
Interaction -> "IsEngaged?";
HandleInteractionEnd [fillcolor=cyan, fontcolor=black, fontsize=9, label=HandleInteractionEnd, shape=octagon, style=filled];
Interaction -> HandleInteractionEnd;
InteractionTasks [fillcolor=gold, fontcolor=black, fontsize=9, label="InteractionTasks\nSuccessOnAll", shape=parallelogram, style=filled];
HandleInteractionEnd -> InteractionTasks;
ActiveTracking [fillcolor=gold, fontcolor=black, fontsize=9, label="ActiveTracking\nSuccessOnAll", shape=parallelogram, style=filled];
InteractionTasks -> ActiveTracking;
ManageFaceTracker [fillcolor=gray, fontcolor=black, fontsize=9, label=ManageFaceTracker, shape=ellipse, style=filled];
ActiveTracking -> ManageFaceTracker;
UpdateTrackingTarget [fillcolor=gray, fontcolor=black, fontsize=9, label=UpdateTrackingTarget, shape=ellipse, style=filled];
ActiveTracking -> UpdateTrackingTarget;
Conversation [fillcolor=orange, fontcolor=black, fontsize=9, label="Ⓜ Conversation", shape=box, style=filled];
InteractionTasks -> Conversation;
SetFace_listening [fillcolor=gray, fontcolor=black, fontsize=9, label=SetFace_listening, shape=ellipse, style=filled];
Conversation -> SetFace_listening;
ListenToUser [fillcolor=gray, fontcolor=black, fontsize=9, label=ListenToUser, shape=ellipse, style=filled];
Conversation -> ListenToUser;
SetFace_thinking [fillcolor=gray, fontcolor=black, fontsize=9, label=SetFace_thinking, shape=ellipse, style=filled];
Conversation -> SetFace_thinking;
GenerateLLMResponse [fillcolor=gray, fontcolor=black, fontsize=9, label=GenerateLLMResponse, shape=ellipse, style=filled];
